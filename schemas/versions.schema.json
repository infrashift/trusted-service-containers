{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/infrashift/trusted-service-containers/schemas/versions.schema.json",
  "title": "trusted-service-containers versions.json",
  "description": "Sovereign source of truth for the mirror track and the built kinds (build, package, native). Validated in pr-gate BEFORE the policy runs, so a malformed entry produces a readable error at PR time rather than a cryptic matrix failure ten minutes later. The policy re-validates the same invariants: JSON Schema catches shape, rego catches meaning.",
  "type": "object",
  "required": ["schemaVersion", "sources", "toolchains", "bases", "images"],
  "additionalProperties": true,

  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$",
      "description": "Always a full sha256 digest. Pins are by digest, never by tag alone."
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$",
      "description": "A 40-hex commit SHA. A tag is NOT a pin: tags move and can be force-pushed; commits cannot."
    },
    "anchoredRegex": {
      "type": "string",
      "pattern": "^\\^.*\\$$",
      "description": "Must be anchored with ^ and $. An unanchored track such as 3\\.90\\. also matches 13.90.7, permitting far more than it appears to."
    },
    "archMap": {
      "type": "object",
      "properties": {
        "amd64": { "type": "object", "required": ["digest"], "properties": { "digest": { "$ref": "#/$defs/digest" } } },
        "arm64": { "type": "object", "required": ["digest"], "properties": { "digest": { "$ref": "#/$defs/digest" } } }
      }
    },
    "nevra": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*-[0-9][A-Za-z0-9._+~^]*-[A-Za-z0-9._+~^]+\\.(x86_64|aarch64|noarch)$",
      "description": "An exact RPM NAME-VERSION-RELEASE.ARCH, as `rpm -q --qf '%{NAME}-%{VERSION}-%{RELEASE}.%{ARCH}'` prints it. A package name alone is not a pin: the repository moves under it."
    },
    "packageRepoArch": {
      "type": "object",
      "required": ["baseurl", "key", "signerFingerprint", "signerFileSha256"],
      "additionalProperties": false,
      "properties": {
        "baseurl": { "type": "string", "pattern": "^https://[^\\s$]+$",
                     "description": "The repository for this architecture, with no $basearch: the label org.opencontainers.image.source and the review compare it literally." },
        "key": { "type": "string", "pattern": "^\\.github/pdp/keyring/[A-Za-z0-9._-]+\\.asc$",
                 "description": "The committed copy of the signing key. Ops.mk check-keyring holds it to its .sha256 sidecar, to signerFileSha256 and to signerFingerprint." },
        "keyUrl": { "type": "string", "pattern": "^https://",
                    "description": "Where the vendor publishes the key. verify-package-pins compares it with the committed copy, so a rotation becomes a reviewed PR." },
        "signerFingerprint": { "type": "string", "pattern": "^[0-9A-F]{40}$",
                            "description": "The v4 fingerprint of the one primary key in the file. Its last 16 hex characters are the key ID that every pinned RPM header signature must name." },
        "signerFileSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  },

  "properties": {
    "schemaVersion": { "const": 2 },
    "destinationRegistry": { "type": "string", "pattern": "^ghcr\\.io/infrashift/trusted-service-containers$" },

    "sources": {
      "type": "object",
      "description": "Git sources for the build track. Images reference these by key, which is what makes Dapr's three images structurally incapable of drifting apart -- there is nowhere to write a second version.",
      "additionalProperties": {
        "type": "object",
        "required": ["track", "ref"],
        "properties": {
          "track": { "$ref": "#/$defs/anchoredRegex" },
          "ref": { "type": "string", "pattern": "^[A-Za-z0-9_][A-Za-z0-9._-]*$",
                  "description": "Interpolated into an OCI tag by build-leg.sh (DEST_TAG=pr-<n>-<ref>-<arch>), so it must satisfy the registry tag grammar. A '+' is valid semver build metadata and an invalid tag; it fails as buildah exit 125." },
          "url": { "type": "string", "format": "uri" },
          "commit": { "$ref": "#/$defs/commit" },
          "shortCommit": { "type": "string", "pattern": "^[0-9a-f]{7,12}$" },
          "lockstep": { "type": "array", "items": { "type": "string" }, "minItems": 2 },
          "archive": {
            "type": "object",
            "required": ["url", "sha256"],
            "additionalProperties": false,
            "description": "The vendor's release archive of this source, pinned by the sha256 the vendor publishes in a second place (Valkey: valkey-io/valkey-hashes). A native build (ADR-010) fetches it with scripts/fetch-archive.sh and fails unless its file tree equals the tree of the pinned commit. The URL must name `ref`, so a bump that moves the commit but not the archive fails.",
            "properties": {
              "url": { "type": "string", "pattern": "^https://[^\\s]+$" },
              "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              "hashSource": { "type": "string", "pattern": "^https://",
                              "description": "Where the vendor publishes the sha256: the second place that makes the hash an independent check of the commit." },
              "note": { "type": "string" }
            }
          },
          "note": { "type": "string" },
          "assets": {
            "type": "object",
            "minProperties": 1,
            "description": "Vendor release files the build needs but cannot produce from the checkout with our toolchain (Prometheus's prebuilt web UI). scripts/fetch-assets.sh fetches each into src/.assets/<service>/<name>, verifies the sha256, and refuses a URL that does not name this source's ref.",
            "additionalProperties": {
              "type": "object",
              "required": ["url", "sha256"],
              "additionalProperties": false,
              "properties": {
                "url": { "type": "string", "pattern": "^https://" },
                "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
                "note": { "type": "string" }
              }
            }
          },
          "repos": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": ["url", "commit"],
              "properties": {
                "url": { "type": "string", "format": "uri" },
                "commit": { "$ref": "#/$defs/commit" }
              }
            }
          }
        },
        "anyOf": [
          { "required": ["commit"] },
          { "required": ["repos"] }
        ]
      }
    },

    "toolchains": {
      "type": "object",
      "additionalProperties": {
        "allOf": [{ "$ref": "#/$defs/archMap" }],
        "type": "object",
        "required": ["image", "tag", "goVersion", "amd64", "arm64"],
        "properties": {
          "image": { "type": "string" },
          "tag": { "type": "string" },
          "goVersion": {
            "type": "string",
            "pattern": "^1\\.[0-9]+\\.[0-9]+$",
            "description": "The compiler patch the pinned digests ship (the image's GOLANG_VERSION). A rolling tag like 1.26-trixie hides it; recording it puts a stale compiler in front of every reviewer. drift-upstream.sh rewrites it with the digests."
          },
          "note": { "type": "string" }
        }
      }
    },

    "bases": {
      "type": "object",
      "additionalProperties": {
        "allOf": [{ "$ref": "#/$defs/archMap" }],
        "type": "object",
        "required": ["image", "role", "trustClass", "amd64", "arm64"],
        "properties": {
          "image": { "type": "string", "pattern": "^ghcr\\.io/infrashift/trusted-base-images/trusted/" },
          "role": { "enum": ["runtime", "ca-trust-donor"] },
          "trustClass": { "const": "internal" },
          "verifyKey": { "type": "string" },
          "note": { "type": "string" }
        }
      }
    },

    "packageRepos": {
      "type": "object",
      "description": "Signed RPM repositories for the package track (ADR-009). A package image names one by key. Each architecture pins its own base URL and key, because a vendor can sign each architecture with a different key (PGDG does).",
      "additionalProperties": {
        "type": "object",
        "required": ["amd64", "arm64"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "amd64": { "$ref": "#/$defs/packageRepoArch" },
          "arm64": { "$ref": "#/$defs/packageRepoArch" },
          "note": { "type": "string" }
        }
      }
    },

    "images": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["kind", "upstreamTrust", "enforcement", "updated", "reason"],
        "properties": {
          "kind": { "enum": ["mirror", "build", "package", "native"] },
          "upstreamTrust": { "enum": ["dhi", "none", "internal", "notation"] },
          "enforcement": { "enum": ["enforce", "observe"] },
          "updated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "reason": { "type": "string", "minLength": 10 }
        },
        "allOf": [
          {
            "if": { "properties": { "upstreamTrust": { "const": "notation" } }, "required": ["upstreamTrust"] },
            "then": {
              "required": ["keyring", "notation"],
              "properties": { "keyring": { "type": "string", "pattern": "^\\.github/pdp/keyring/.*\\.crt$" } }
            }
          },
          {
            "if": { "properties": { "kind": { "const": "mirror" } }, "required": ["kind"] },
            "then": {
              "required": ["upstreamRepo", "platforms", "variants"],
              "properties": {
                "upstreamRepo": { "type": "string" },
                "keyring": { "type": ["string", "null"] },
                "requiredPredicates": { "type": "array", "items": { "type": "string" } },
                "notation": {
                  "type": "object",
                  "required": ["trustedIdentity", "rootUrl"],
                  "properties": {
                    "trustedIdentity": { "type": "string", "pattern": "^x509\\.subject: (?=(.*,)?CN=[^,]+)(?=(.*,)?O=[^,]+).*$",
                      "description": "Notary matches x509.subject as an attribute subset with only C/ST/O mandatory, so CN is required here: without it every leaf the vendor CA issues would verify." },
                    "rootUrl": { "type": "string", "pattern": "^https://" }
                  }
                },
                "platforms": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
                "variants": {
                  "type": "object",
                  "minProperties": 1,
                  "additionalProperties": {
                    "type": "object",
                    "required": ["tag", "track", "digest"],
                    "properties": {
                      "tag": { "type": "string", "minLength": 1 },
                      "track": { "$ref": "#/$defs/anchoredRegex" },
                      "digest": { "$ref": "#/$defs/digest" }
                    }
                  }
                }
              }
            }
          },
          {
            "if": { "properties": { "kind": { "const": "build" } }, "required": ["kind"] },
            "then": {
              "required": ["source", "toolchain", "base", "caSource", "arches", "containerfile", "build", "runtime"],
              "description": "Exactly one of `crosscheck` (a vendor binary exists and is compared) or `firstParty` (no vendor binary exists, with a reason). Neither is a schema error, never an implicit first-party claim. The repo gate additionally restricts firstParty to sources under https://github.com/infrashift/.",
              "oneOf": [
                { "required": ["crosscheck"], "not": { "required": ["firstParty"] } },
                { "required": ["firstParty"], "not": { "required": ["crosscheck"] } }
              ],
              "properties": {
                "upstreamTrust": { "const": "internal" },
                "source": { "type": "string" },
                "repo": { "type": "string" },
                "toolchain": { "type": "string" },
                "base": { "type": "string" },
                "caSource": { "type": "string" },
                "arches": { "type": "array", "items": { "enum": ["amd64", "arm64"] }, "minItems": 1 },
                "containerfile": { "type": "string", "pattern": "^Containerfiles/.+\\.Containerfile$" },
                "build": {
                  "type": "object",
                  "required": ["cgo", "mainPackage", "binary", "installPath", "ldflagsVars"],
                  "oneOf": [
                    { "properties": { "ldflagsVars": { "minProperties": 1 } }, "not": { "required": ["noVersionSymbol"] } },
                    { "required": ["noVersionSymbol"], "properties": { "ldflagsVars": { "maxProperties": 0 } } }
                  ],
                  "properties": {
                    "cgo": { "const": false, "description": "Every service in this repo is a static CGO_ENABLED=0 Go binary. CGO=1 on a Debian builder produces glibc-2.41 binaries that cannot run on ubi9's glibc 2.34." },
                    "trimpath": { "type": "boolean" },
                    "goToolchain": { "type": "string" },
                    "tags": { "type": "array", "items": { "type": "string", "pattern": "^[A-Za-z0-9_.]+$" }, "minItems": 1,
                      "description": "Go build tags. scripts/lint-containerfiles.sh asserts the build passes exactly -tags=<these, comma-joined>." },
                    "extraBinaries": {
                      "type": "array", "minItems": 1,
                      "description": "Further binaries built from the same checkout and shipped beside the primary one (promtool beside prometheus). Only `binary` is cross-checked against the vendor's image.",
                      "items": {
                        "type": "object",
                        "required": ["binary", "mainPackage", "installPath"],
                        "additionalProperties": false,
                        "properties": {
                          "binary": { "type": "string" },
                          "mainPackage": { "type": "string" },
                          "installPath": { "type": "string", "pattern": "^/usr/bin/" }
                        }
                      }
                    },
                    "mainPackage": { "type": "string" },
                    "binary": { "type": "string" },
                    "installPath": { "type": "string", "pattern": "^/usr/bin/" },
                    "compatSymlink": { "type": "string", "pattern": "^/" },
                    "extraLdflags": { "type": "string" },
                    "commitForm": { "enum": ["full", "short"] },
                    "ldflagsVars": { "type": "object", "additionalProperties": { "type": "string" },
                      "description": "Symbols the build stamps with -X. At least one, unless `noVersionSymbol` explains why the program has none; then it must be empty." },
                    "noVersionSymbol": { "type": "string", "minLength": 40,
                      "description": "Why the program has no version variable to stamp (Chit). An explicit, reasoned exception to a non-empty ldflagsVars: the Go linker silently ignores -X for a symbol that does not exist, so inventing one would claim a stamp that never happens. scripts/lint-containerfiles.sh then rejects any -X in the build." },
                    "note": { "type": "string" }
                  }
                },
                "crosscheck": {
                  "allOf": [{ "$ref": "#/$defs/archMap" }],
                  "type": "object",
                  "required": ["image", "binaryPath", "trustClass", "reproducibilityTier"],
                  "properties": {
                    "image": { "type": "string" },
                    "binaryPath": { "type": "string", "pattern": "^/" },
                    "trustClass": { "enum": ["none", "docker-official"] },
                    "reproducibilityTier": {
                      "enum": ["flag-matched", "best-effort"],
                      "description": "flag-matched means upstream pins its toolchain and uses -trimpath, so a byte-identical result is realistic and a MISMATCH is worth investigating. best-effort means a mismatch is expected and proves nothing."
                    },
                    "releaseTarballSha256": { "type": "object", "additionalProperties": { "type": "string", "pattern": "^[a-f0-9]{64}$" } },
                    "note": { "type": "string" }
                  }
                },
                "firstParty": {
                  "type": "object",
                  "required": ["noVendorBinary", "reason"],
                  "additionalProperties": false,
                  "description": "Declares that no vendor binary exists to cross-check against, because we are the vendor. The dual-provenance comparison is then replaced by a recorded first-party observation. Only a source under https://github.com/infrashift/ may declare it (policy rule VERSIONS_FIRST_PARTY_SOURCE_NOT_INFRASHIFT); otherwise anyone could mark a vendor image first-party to skip the cross-check.",
                  "properties": {
                    "noVendorBinary": { "const": true },
                    "reason": { "type": "string", "minLength": 40,
                      "description": "Why no vendor binary exists. The policy requires at least 40 characters, as it does for a waiver justification." }
                  }
                },
                "runtime": {
                  "type": "object",
                  "required": ["ports", "entrypoint", "user"],
                  "properties": {
                    "ports": { "type": "array", "items": { "type": "integer", "minimum": 1, "maximum": 65535 } },
                    "volumes": { "type": "array", "items": { "type": "string", "pattern": "^/" } },
                    "entrypoint": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
                    "cmd": { "type": "array", "items": { "type": "string" } },
                    "user": { "const": 1001 },
                    "tzdata": { "type": "boolean" }
                  }
                }
              }
            }
          },
          {
            "if": { "properties": { "kind": { "const": "package" } }, "required": ["kind"] },
            "then": {
              "required": ["base", "arches", "containerfile", "packages", "runtime"],
              "not": { "anyOf": [
                { "required": ["source"] }, { "required": ["toolchain"] }, { "required": ["build"] },
                { "required": ["crosscheck"] }, { "required": ["variants"] } ] },
              "properties": {
                "upstreamTrust": { "const": "internal" },
                "base": { "type": "string" },
                "arches": { "type": "array", "items": { "enum": ["amd64", "arm64"] }, "minItems": 1, "uniqueItems": true },
                "containerfile": { "type": "string", "pattern": "^Containerfiles/.+\\.Containerfile$" },
                "packages": {
                  "type": "object",
                  "required": ["repo", "version", "track"],
                  "additionalProperties": false,
                  "properties": {
                    "repo": { "type": "string", "description": "A key of packageRepos." },
                    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$",
                                 "description": "The upstream version that every pinned NEVRA carries. It is the release tag (<version>-<shortsha>), so it must satisfy the registry tag grammar." },
                    "track": { "$ref": "#/$defs/anchoredRegex",
                               "description": "Bounds the VERSION-RELEASE of every pinned NEVRA. drift-upstream.sh proposes only a version-release inside it." },
                    "amd64": { "type": "array", "items": { "$ref": "#/$defs/nevra" }, "minItems": 1, "uniqueItems": true },
                    "arm64": { "type": "array", "items": { "$ref": "#/$defs/nevra" }, "minItems": 1, "uniqueItems": true },
                    "note": { "type": "string" }
                  }
                },
                "runtime": {
                  "type": "object",
                  "required": ["ports", "entrypoint", "user"],
                  "properties": {
                    "ports": { "type": "array", "items": { "type": "integer", "minimum": 1, "maximum": 65535 } },
                    "volumes": { "type": "array", "items": { "type": "string", "pattern": "^/" } },
                    "entrypoint": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
                    "cmd": { "type": "array", "items": { "type": "string" } },
                    "user": { "type": "integer", "minimum": 1, "description": "Never 0: the package's own system user (26 is the RHEL postgres user)." },
                    "dataDirectory": { "type": "string", "pattern": "^/" },
                    "env": { "type": "array", "items": { "type": "string" } },
                    "note": { "type": "string" }
                  }
                }
              }
            }
          },
          {
            "if": { "properties": { "kind": { "const": "native" } }, "required": ["kind"] },
            "then": {
              "description": "ADR-010. Built on a pinned UBI builder (`builder`, a key of bases) with the compiler from the Red Hat signed UBI repositories, onto a pinned runtime base. Language `c` compiles the pinned commit of `source`, whose `archive` pins the vendor's release archive. No vendor binary comparison: the hash of our binary is recorded as a change detector.",
              "required": ["source", "builder", "base", "arches", "containerfile", "native", "runtime"],
              "not": { "anyOf": [
                { "required": ["toolchain"] }, { "required": ["caSource"] }, { "required": ["build"] },
                { "required": ["crosscheck"] }, { "required": ["firstParty"] }, { "required": ["packages"] },
                { "required": ["variants"] }, { "required": ["repo"] } ] },
              "properties": {
                "upstreamTrust": { "const": "internal" },
                "source": { "type": "string", "description": "A key of sources. That source must pin `archive`." },
                "builder": { "type": "string", "description": "A key of bases: the UBI image the builder stage runs on, pinned by digest per arch." },
                "base": { "type": "string", "description": "A key of bases: the runtime base." },
                "arches": { "type": "array", "items": { "enum": ["amd64", "arm64"] }, "minItems": 1, "uniqueItems": true },
                "containerfile": { "type": "string", "pattern": "^Containerfiles/.+\\.Containerfile$" },
                "native": {
                  "type": "object",
                  "required": ["language", "buildPackages", "binary", "installPath"],
                  "additionalProperties": false,
                  "properties": {
                    "language": { "enum": ["c"] },
                    "buildPackages": { "type": "array", "minItems": 1, "uniqueItems": true,
                      "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$" },
                      "description": "RPM names the builder installs from the signed UBI repositories. Names, not NEVRAs: UBI content is not pinned by NEVRA (ADR-009). The SBOM of the builder is not shipped; the provenance records this list." },
                    "binary": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
                    "installPath": { "type": "string", "pattern": "^/usr/bin/[A-Za-z0-9][A-Za-z0-9._-]*$",
                                     "description": "Where the primary binary lands. Its sha256 is recorded as the change detector of ADR-004." },
                    "extraBinaries": { "type": "array", "minItems": 1, "uniqueItems": true,
                      "items": { "type": "string", "pattern": "^/usr/bin/[A-Za-z0-9][A-Za-z0-9._-]*$" } },
                    "makeFlags": { "type": "array", "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*=[A-Za-z0-9._-]*$" },
                      "description": "Flags scripts/lint-containerfiles.sh requires on the make command line, so a reviewer of versions.json sees how the binary is built." },
                    "note": { "type": "string" }
                  }
                },
                "runtime": {
                  "type": "object",
                  "required": ["ports", "entrypoint", "user"],
                  "properties": {
                    "ports": { "type": "array", "items": { "type": "integer", "minimum": 1, "maximum": 65535 } },
                    "volumes": { "type": "array", "items": { "type": "string", "pattern": "^/" } },
                    "entrypoint": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
                    "cmd": { "type": "array", "items": { "type": "string" } },
                    "user": { "const": 1001 },
                    "configFile": { "type": "string", "pattern": "^rootfs/" },
                    "note": { "type": "string" }
                  }
                }
              }
            }
          }
        ]
      }
    }
  }
}
