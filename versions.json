      "enforcement": "enforce",
      "arches": [
        "amd64",
        "arm64"
      ],
      "containerfile": "Containerfiles/keto.Containerfile",
      "build": {
        "cgo": false,
        "tags": [
          "json1"
        ],
        "trimpath": false,
        "mainPackage": ".",
        "binary": "keto",
        "installPath": "/usr/bin/keto",
        "extraLdflags": "-s -w",
        "ldflagsVars": {
          "version": "github.com/ory/keto/internal/driver/config.Version",
          "commit": "github.com/ory/keto/internal/driver/config.Commit",
          "date": "github.com/ory/keto/internal/driver/config.Date"
        },
        "note": "Keto's .docker/Dockerfile-build sets CGO_ENABLED=1, but that is the dev build. The released -distroless image is CGO-free and keto's sqlite driver is modernc.org/sqlite (pure Go), so CGO is not needed. Verify `keto migrate up` works before trusting this."
      },
      "crosscheck": {
        "image": "docker.io/oryd/keto",
        "binaryPath": "/usr/bin/keto",
        "trustClass": "none",
        "reproducibilityTier": "best-effort",
        "amd64": {
          "tag": "v26.2.0-amd64-distroless",
          "digest": "sha256:b58d58f610f69cd73e0ae0482dbbfece45b450ac146574851fe06262ba4b40be"
        },
        "arm64": {
          "tag": "v26.2.0-arm64-distroless",
          "digest": "sha256:9e6a7c6f19ef38e38bb8477bde692bfa5b5a8bbf737c8308aa8b0714bbaf2f90"
        }
      },
      "runtime": {
        "ports": [
          4466,
          4467
        ],
        "volumes": [],
        "entrypoint": [
