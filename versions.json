        "trimpath": false,
        "mainPackage": ".",
        "binary": "oathkeeper",
        "installPath": "/usr/bin/oathkeeper",
        "extraLdflags": "-s -w",
        "ldflagsVars": {
          "version": "github.com/ory/oathkeeper/x.Version",
          "commit": "github.com/ory/oathkeeper/x.Commit",
          "date": "github.com/ory/oathkeeper/x.Date"
