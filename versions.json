{
  "schemaVersion": 2,
  "destinationRegistry": "ghcr.io/infrashift/trusted-service-containers",
  "_comment": [
    "Sovereign source of truth. No digest may be hardcoded anywhere else.",
    "Digests marked sha256:0000... require an authenticated dhi.io login to resolve;",
    "see SETUP-ENVIRONMENTS.md step 7. Every other digest was resolved live on",
    "2026-08-18 and should be re-checked with `make -f Ops.mk verify-pins`.",
    "CODEOWNERS puts this file under @infrashift/security-admins: a `track` widening",
    "is a one-character edit that silently converts every future release from a",
    "reviewed decision into an automated bump."
  ],
  "sources": {
    "ory": {
      "track": "^v26\\.[0-9]+\\.[0-9]+$",
      "ref": "v26.2.0",
      "note": "All four Ory services release in lockstep off a shared tag. A partial bump is a bug; drift-upstream.yml must propose all four together.",
      "repos": {
        "kratos": {
          "url": "https://github.com/ory/kratos",
          "commit": "9d7085948039ffb8960160d4979f71527b5cf4d5"
        },
        "hydra": {
          "url": "https://github.com/ory/hydra",
          "commit": "0b84568fffccf151dc5e6c7955fdfb738555bf4b"
        },
        "keto": {
          "url": "https://github.com/ory/keto",
          "commit": "e4393662cd2e744deeb79de77669e07b6ccf51f3"
        },
        "oathkeeper": {
          "url": "https://github.com/ory/oathkeeper",
          "commit": "c84dbe07ecbf6f10154f04ec49b137a115155289"
        }
      }
    },
    "nats": {
      "track": "^v2\\.14\\.[0-9]+$",
      "ref": "v2.14.5",
      "url": "https://github.com/nats-io/nats-server",
      "commit": "d3bc0453384d00d37991b084263e59af828fa90d",
      "shortCommit": "d3bc04533",
      "shortCommitNote": "goreleaser stamps {{.ShortCommit}}, whose length is git's DYNAMIC abbreviation for the full repo. Verified empirically: the released v2.14.5 binary embeds 9 characters. It cannot be derived from our build, because fetch-source.sh makes a --depth 1 clone and git then abbreviates to the 7-char minimum. Pinning it as data is the only way to reproduce the vendor's binary; drift PRs must update it alongside `commit`.",
      "note": "Moved up from the 2.11 line the user ran previously. Upstream pins GOTOOLCHAIN and uses -trimpath, so this is the one service where a byte-identical cross-check is realistic."
    },
    "dapr": {
      "track": "^v1\\.18\\.[0-9]+$",
      "ref": "v1.18.3",
      "url": "https://github.com/dapr/dapr",
      "commit": "2dcf2e3548faf3c740b3d29ee300e2132db65cff",
      "lockstep": [
        "daprd",
        "dapr-placement",
        "dapr-scheduler"
      ],
      "note": "One source repo produces all three images. Moved up from 1.14.4, which is outside Dapr's N-2 support window. Scheduler is included because from 1.15+ actor reminders and workflows require it."
    }
  },
  "toolchains": {
    "go1.26": {
      "image": "docker.io/library/golang",
      "tag": "1.26-trixie",
      "amd64": {
        "digest": "sha256:23fdfd3a6abc97c81e32a724cdd1cf541c06c416eb04d717815f4ed7c75623d0"
      },
      "arm64": {
        "digest": "sha256:a0c0dd6888e2a1df54a00fcafe855e3035dcf9b5733cdf803d6ccf70a56df809"
      },
      "note": "Also the donor for /usr/share/zoneinfo, which ubi9-micro does not ship."
    }
  },
  "bases": {
    "ubi9-micro": {
      "image": "ghcr.io/infrashift/trusted-base-images/trusted/ubi9-micro",
      "role": "runtime",
      "trustClass": "internal",
      "verifyKey": ".github/pdp/public-keys/upstream/trusted-base-images-release.pub",
      "amd64": {
        "digest": "sha256:b2485542880b0f6482469c60934e97eb0446b09959e96106907481816e74c230"
      },
      "arm64": {
        "digest": "sha256:dab2fd48fdccb15aab566a629ab2f086f45014723a86f2ce7c49395d4d765290"
      },
      "note": "VERIFIED 2026-08-18: ships NO CA trust bundle, NO tzdata, and NO UID 1001 in /etc/passwd. It DOES have bash, coreutils and glibc, so RUN works. Registry path is trusted-base-images, not trusted-base-oci-images (the sibling's directory name differs from its git remote). arm64 is published as arm64/v8; always pin by digest."
    },
    "ubi9-minimal": {
      "image": "ghcr.io/infrashift/trusted-base-images/trusted/ubi9-minimal",
      "role": "ca-trust-donor",
      "trustClass": "internal",
      "verifyKey": ".github/pdp/public-keys/upstream/trusted-base-images-release.pub",
      "amd64": {
        "digest": "sha256:8073bce76a1842ce7559e6870f88b7473ff14d0ee2f0af0d49fe44749a17e4bf"
      },
      "arm64": {
        "digest": "sha256:b458b9a9b9c90f7d579a353cb4c3f7e9e71f90698a2521a657197b7c32644e5a"
      },
      "note": "Donor for /etc/pki/ca-trust/extracted/pem/tls-ca-bundle.pem only. Assert the copied bundle is >100000 bytes so a truncated one fails loudly."
    }
  },
  "images": {
    "traefik": {
      "kind": "mirror",
      "upstreamTrust": "dhi",
      "upstreamRepo": "dhi.io/traefik",
      "keyring": ".github/pdp/keyring/dhi-latest.pub",
      "requiredPredicates": [
        "https://cyclonedx.org/bom/v1.6",
        "https://slsa.dev/provenance/v1"
      ],
      "enforcement": "enforce",
      "platforms": [
        "linux/amd64",
        "linux/arm64"
      ],
      "variants": {
        "runtime": {
          "tag": "3-debian13",
          "track": "^3-debian13$",
          "digest": "sha256:734fb24f3fbdf5e664fb750753e11edc54dcf99706b714612a66837466fd3ad8"
        },
        "dev": {
          "tag": "3-debian13-dev",
          "track": "^3-debian13-dev$",
          "digest": "sha256:09733296caf52acf53c3ab12ab698fed48ca0cd408b374940c987460bc90cc39"
        }
      },
      "updated": "2026-08-24",
      "reason": "Placeholder digests resolved 2026-08-24 with an authenticated dhi.io login (regctl manifest head, index digest). DHI repoints 3-debian13 itself, so the tag string never changes and only the digest moves; track is therefore an exact match."
    },
    "postgres": {
      "kind": "mirror",
      "upstreamTrust": "dhi",
      "upstreamRepo": "dhi.io/postgres",
      "keyring": ".github/pdp/keyring/dhi-latest.pub",
