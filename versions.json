        "note": "Oathkeeper stamps into package x, NOT driver/configuration. Confirmed from .goreleaser.yml at v26.2.0. Getting this wrong is silent: the binary compiles and reports `dev`."
      },
      "crosscheck": {
        "image": "docker.io/oryd/oathkeeper",
        "binaryPath": "/usr/bin/oathkeeper",
        "trustClass": "none",
        "reproducibilityTier": "best-effort",
        "amd64": {
          "tag": "v26.2.0-amd64-distroless",
          "digest": "sha256:af1c08d4ca731166f46f29ba60d1e850ef115e4511d5131c8a895b39367415e4"
        },
        "arm64": {
          "tag": "v26.2.0-arm64-distroless",
          "digest": "sha256:291e39c9fcb1cbb1184d7c8cce303da158e69c9d147357cfb82abbc13e558d60"
        }
      },
      "runtime": {
        "ports": [
          4455,
          4456
        ],
        "volumes": [],
        "entrypoint": [
          "oathkeeper"
        ],
        "cmd": [
          "serve"
        ],
        "user": 1001,
        "tzdata": true
      },
      "updated": "2026-08-18",
      "reason": "Initial pin. Upstream's .docker/Dockerfile-build has a bug (COPY oryx/go.sum proto/go.sum); we do not use it."
    },
    "nats": {
      "kind": "build",
      "source": "nats",
      "upstreamTrust": "internal",
      "toolchain": "go1.26",
      "base": "ubi9-micro",
      "caSource": "ubi9-minimal",
      "enforcement": "enforce",
      "arches": [
        "amd64",
        "arm64"
      ],
      "archNote": "Upstream also publishes arm/v6, arm/v7, 386, ppc64le, s390x and loong64. We build linux/amd64 and linux/arm64 only.",
      "containerfile": "Containerfiles/nats.Containerfile",
      "build": {
        "cgo": false,
        "trimpath": true,
        "goToolchain": "go1.26.5",
        "mainPackage": ".",
        "binary": "nats-server",
        "installPath": "/usr/bin/nats-server",
        "compatSymlink": "/nats-server",
        "extraLdflags": "-w",
        "commitForm": "short",
        "ldflagsVars": {
          "version": "github.com/nats-io/nats-server/v2/server.serverVersion",
          "commit": "github.com/nats-io/nats-server/v2/server.gitCommit"
        },
        "note": "Flags mirror upstream .goreleaser.yml exactly: -trimpath, CGO_ENABLED=0, GOTOOLCHAIN=go1.26.5, -w (not -s -w). serverVersion takes the tag; gitCommit takes goreleaser's .ShortCommit."
      },
      "crosscheck": {
        "image": "docker.io/library/nats",
        "binaryPath": "/usr/local/bin/nats-server",
        "trustClass": "docker-official",
        "reproducibilityTier": "best-effort",
        "amd64": {
          "tag": "2.14.5-alpine3.22",
          "digest": "sha256:bacc5a40233588bd10201a2576903d9bfcc3bf84261ed324e522df2666e5eefd"
        },
        "arm64": {
          "tag": "2.14.5-alpine3.22",
          "digest": "sha256:205044f329047936e25b9946d4f8af0d13eb5af83993bb66b61a857631e94408"
        },
        "releaseTarballSha256": {
          "amd64": "5e3b603d47c447bda1f77f9ac16dbf91c90aac4ff3681f8fbbc7201e4ed99355",
          "arm64": "673a98d3faa79dde3f9ebf16d6dfac36a5f694e7ad2015e4954dd7939c85cd4c"
        },
        "note": "Second, independent anchor: the official image does not compile the binary, it downloads the GitHub release tarball and verifies these sha256 values inline in nats-docker/2.14.x/alpine3.22/Dockerfile. Both were confirmed to match on 2026-08-18, and the binary inside the official image is byte-identical to the released tarball. TIER DOWNGRADED from flag-matched to best-effort after empirical testing: we reproduced every observable build input -- Go 1.26.5, identical dep set, -trimpath, CGO_ENABLED=0, GOAMD64=v1, DefaultGODEBUG, mod=v2.14.5, vcs.revision/time/modified=false, and the 9-char short commit -- and the binary still differs. Whatever remains is not visible in `go version -m`. Do not treat a NATS mismatch as alarming until someone identifies the residual input."
      },
      "runtime": {
        "ports": [
          4222,
          8222,
          6222
        ],
        "volumes": [
          "/var/lib/nats"
        ],
        "entrypoint": [
          "nats-server"
        ],
        "cmd": [
          "--config",
          "/etc/nats/nats-server.conf"
        ],
        "user": 1001,
        "tzdata": true,
        "configFile": "rootfs/nats/etc/nats/nats-server.conf",
        "configNote": "Ours, not upstream's. nats-docker ships a cluster block with hardcoded credentials ruser/T0pS3cr3t. All three ports are >1024 so non-root binding is fine."
      },
      "updated": "2026-08-18",
      "reason": "Initial pin on the 2.14 line, moved up from the 2.11-alpine image previously in use."
    },
    "daprd": {
      "kind": "build",
      "source": "dapr",
      "upstreamTrust": "internal",
      "toolchain": "go1.26",
      "base": "ubi9-micro",
      "caSource": "ubi9-minimal",
      "enforcement": "enforce",
      "arches": [
        "amd64",
        "arm64"
      ],
      "archNote": "Upstream index is a Docker manifest list that also contains windows/amd64 and linux/arm/v7. Cross-check pins per-platform tags so extraction never depends on runtime manifest-list resolution.",
      "containerfile": "Containerfiles/daprd.Containerfile",
      "build": {
        "cgo": false,
        "mainPackage": "./cmd/daprd",
        "binary": "daprd",
        "installPath": "/usr/bin/daprd",
        "compatSymlink": "/daprd",
        "extraLdflags": "-s -w",
        "ldflagsVars": {
          "commit": "github.com/dapr/dapr/pkg/buildinfo.gitcommit",
          "gitversion": "github.com/dapr/dapr/pkg/buildinfo.gitversion",
          "version": "github.com/dapr/dapr/pkg/buildinfo.version",
          "kitVersion": "github.com/dapr/kit/logger.DaprVersion"
        }
      },
      "crosscheck": {
        "image": "docker.io/daprio/daprd",
        "binaryPath": "/daprd",
        "trustClass": "none",
        "reproducibilityTier": "best-effort",
        "amd64": {
          "tag": "1.18.3-linux-amd64",
          "digest": "sha256:d06339fe9dcc4c7180d914d3d7b60b7e3324dc065955fedafe1bf434d266631d"
        },
        "arm64": {
          "tag": "1.18.3-linux-arm64",
          "digest": "sha256:faa4e053377c37c88ad39c176f8b26fc22617232857f54a8d2b5be6dea6be5d6"
        }
      },
      "runtime": {
        "ports": [
          3500,
          50001,
          50002,
          9090
        ],
        "volumes": [],
        "entrypoint": [
          "/usr/bin/daprd"
        ],
        "cmd": [],
        "user": 1001,
