          "tag": "v26.2.0-amd64-distroless",
          "digest": "sha256:abb3de0757000d860ee3da274ff5bdeb2b8d031b4aed89f2fb1b5b22affe7690"
        },
        "arm64": {
          "tag": "v26.2.0-arm64-distroless",
          "digest": "sha256:41850339546e7aa8adaff78b3a386adaf38e08bc991101e8f602e83562f18acd"
        }
      },
      "runtime": {
        "ports": [
          4444,
          4445
        ],
        "volumes": [],
        "entrypoint": [
          "hydra"
        ],
        "cmd": [
          "serve",
          "all"
        ],
        "user": 1001,
        "tzdata": true
      },
      "updated": "2026-08-18",
      "reason": "Initial pin. Note the module path carries /v2. Hydra has no .docker/Dockerfile-build (it has Dockerfile-local-build); the ldflags paths come from .goreleaser.yml."
    },
    "keto": {
      "kind": "build",
      "source": "ory",
      "repo": "keto",
      "upstreamTrust": "internal",
      "toolchain": "go1.26",
