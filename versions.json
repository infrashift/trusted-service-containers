      "platforms": [
        "linux/amd64",
        "linux/arm64"
      ],
      "variants": {
        "runtime": {
          "tag": "16-debian",
          "track": "^16-debian$",
          "digest": "sha256:c40f96887b66e68b6021f7b50193aea6ba9cbaad7006cc431bc21c00e2ae7812"
        },
        "dev": {
          "tag": "16-debian-dev",
          "track": "^16-debian-dev$",
          "digest": "sha256:ec61df9ae2947ac2c807473f2c46dcf33015499f31199132a2c8f5f3409fe675"
        }
      },
      "updated": "2026-08-24",
      "reason": "Initial pin, runtime + dev."
    },
    "nexus3": {
      "kind": "mirror",
      "upstreamTrust": "none",
      "upstreamRepo": "docker.io/sonatype/nexus3",
      "keyring": null,
      "requiredPredicates": [],
      "enforcement": "observe",
      "platforms": [
        "linux/amd64",
        "linux/arm64"
      ],
      "variants": {
        "runtime": {
          "tag": "3.90.5-ubi",
          "track": "^3\\.90\\.[0-9]+-ubi$",
          "digest": "sha256:3d6454ebafb3e807782c15dc9a500b83013107128e35db5da219fda05c07b68c"
        }
      },
      "updated": "2026-08-18",
      "reason": "Tracks the 3.90 patch line only; 3.91.0-ubi and 3.91.1-ubi already exist upstream, so a naive newest-tag check would jump a minor on its first run. Trust class none: public Docker Hub image with unsigned BuildKit attestations only. Onboarded in `observe` until the day-one CVE triage lands in exceptions.yaml -- a ~700MB JVM image will very likely quarantine."
    },
    "kratos": {
      "kind": "build",
      "source": "ory",
      "repo": "kratos",
      "upstreamTrust": "internal",
      "toolchain": "go1.26",
      "base": "ubi9-micro",
      "caSource": "ubi9-minimal",
      "enforcement": "enforce",
      "arches": [
        "amd64",
        "arm64"
      ],
      "containerfile": "Containerfiles/kratos.Containerfile",
      "build": {
        "cgo": false,
        "tags": [
          "json1"
        ],
        "trimpath": false,
        "mainPackage": ".",
        "binary": "kratos",
        "installPath": "/usr/bin/kratos",
        "extraLdflags": "-s -w",
        "ldflagsVars": {
          "version": "github.com/ory/kratos/driver/config.Version",
          "commit": "github.com/ory/kratos/driver/config.Commit",
          "date": "github.com/ory/kratos/driver/config.Date"
        }
      },
      "crosscheck": {
        "image": "docker.io/oryd/kratos",
        "binaryPath": "/usr/bin/kratos",
        "trustClass": "none",
        "reproducibilityTier": "best-effort",
        "amd64": {
          "tag": "v26.2.0-amd64-distroless",
          "digest": "sha256:a5e61d8b6ba113523b65a21577489041c5401f1b5afb62a43f154c44d5e91eaa"
        },
        "arm64": {
          "tag": "v26.2.0-arm64-distroless",
          "digest": "sha256:39b0ba42818ba03ea5b039546574e445e7b43226ff0d33d3de81ae990b6cde61"
        },
        "note": "The -distroless tag, NOT the bare v26.2.0 tag. The bare tag is the Alpine/musl CGO_ENABLED=1 -tags=sqlite,hsm,json1 build (User 10000, 3.6MB base layer) and is not comparable to ours. Ory's cosign signature has Cert:false/Chain:false and no published public key, so we pin by digest and do not claim to verify it."
      },
      "runtime": {
        "ports": [
          4433,
          4434
        ],
        "volumes": [
          "/var/lib/sqlite"
        ],
        "entrypoint": [
          "kratos"
        ],
        "cmd": [
          "serve"
        ],
        "user": 1001,
        "tzdata": true
      },
      "updated": "2026-08-18",
      "reason": "Initial pin. No official UBI-based Ory image exists; built from source onto ubi9-micro."
    },
